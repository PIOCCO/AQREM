# Leave empty in dev: Vite proxies /api to the backend on the same host.
# Only set this for a production build served without the dev proxy, e.g.:
# VITE_API_BASE=http://100.64.0.12:8000
VITE_API_BASE=

# Employee UI: V1 is the default (omit or true). Set false only for the legacy workspace UI.
# VITE_PRODUCT_V1=false
