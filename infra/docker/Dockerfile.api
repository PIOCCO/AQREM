FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libmagic1 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 1001 aqrem \
    && useradd --system --uid 1001 --gid aqrem --create-home aqrem

COPY backend/pyproject.toml /app/backend/
RUN pip install --no-cache-dir -e /app/backend[dev]

COPY backend /app/backend
COPY worker /app/worker
COPY infra/docker/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# /app so `worker.app.*` imports resolve (/app/worker/app/…); /app/backend first so `app.*` is the API.
ENV PYTHONPATH=/app/backend:/app/worker:/app
ENV APP_ENV=production

WORKDIR /app/backend
USER root
ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
