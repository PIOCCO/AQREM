# Production web UI (Vite build + nginx). V1 is on unless VITE_PRODUCT_V1=false at build time.
FROM node:20-bookworm-slim AS build
WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ .

ARG VITE_PRODUCT_V1=true
ARG VITE_BUILD_ID=unknown
ARG VITE_API_BASE=
ARG VITE_PUBLIC_APP_URL=
ENV VITE_PRODUCT_V1=${VITE_PRODUCT_V1}
ENV VITE_BUILD_ID=${VITE_BUILD_ID}
ENV VITE_API_BASE=${VITE_API_BASE}
ENV VITE_PUBLIC_APP_URL=${VITE_PUBLIC_APP_URL}

RUN npm run build

FROM nginx:1.27-alpine
COPY infra/docker/nginx-web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
