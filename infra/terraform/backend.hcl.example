# Copy to backend.hcl (gitignored) and run:  terraform init -backend-config=backend.hcl
# Values are identifiers, not secrets. Auth uses your Entra ID login (az login / OIDC); shared keys are
# disabled on the state account, so no storage key or SAS exists. The identity needs
# "Storage Blob Data Contributor" on the container (infra/terraform/stacks/state grants it per container).
resource_group_name  = "rg-aqrem-tfstate"
storage_account_name = "staqremtfstate01" # globally unique, 3-24 lowercase alphanumerics
container_name       = "tfstate-platform"
key                  = "openai/dev.tfstate" # use openai/production.tfstate for prod
use_azuread_auth     = true
