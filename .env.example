# Application
APP_ENV=development
SECRET_KEY=change-me-in-production
# Public browser URL for invitation/join links (Tailscale in dev, Azure/custom domain in prod). No trailing slash.
# Also added to CORS allowlist automatically (production API).
# PUBLIC_BASE_URL=http://100.80.43.124:5173
# PUBLIC_APP_URL=http://100.80.43.124:5173
# When APP_ENV=production, set this to the exact Vite origin (scheme + host + port) if it differs from PUBLIC_BASE_URL:
# CORS_ALLOWED_ORIGINS=http://100.80.43.124:5173
# Docker Compose sets APP_ENV=development on api/worker; the API image alone defaults to production — set APP_ENV in .env if not using Compose.
# Frontend display fallback when rendering URLs client-side (optional if API returns invite_url):
# VITE_PUBLIC_APP_URL=http://100.80.43.124:5173

# Web Docker build (docker-compose.local-prod.yml → web.build.args). Default is V1.
# VITE_PRODUCT_V1=true
# Optional git SHA for admin build marker in the UI:
# VITE_BUILD_ID=
# Invitation email verification resend cooldown (seconds, default 15):
# VERIFICATION_RESEND_COOLDOWN_SECONDS=15
# Document indexing UI/timeouts (seconds):
# QUEUE_WAIT_WARN_SECONDS=60
# INDEXING_STALE_SECONDS=120
# INDEXING_MAX_SECONDS=900
# Local prod stack (docker-compose.local-prod.yml) loads this .env into api/worker — set EMAIL_PROVIDER=brevo here.
# Do not set AZURE_STORAGE_CONNECTION_STRING to http://127.0.0.1:10000 for local-prod Docker — compose uses LOCAL_UPLOAD_DIR instead.
# Production: APP_ENV=production, strong SECRET_KEY (32+ chars).
# Public registration is disabled by default (ALLOW_PUBLIC_REGISTRATION=false).
# ALLOW_PUBLIC_REGISTRATION=false
# Dev-only: zero-seat test orgs (license_status=test) may sign in when true; forced off in production.
# LICENSING_TEST_MODE=true
# Bootstrap platform administrator (optional — creates super admin if missing; never creates orgs):
# PLATFORM_ADMIN_EMAIL=admin@yourcompany.example
# PLATFORM_ADMIN_PASSWORD=use-a-strong-password
# PLATFORM_ADMIN_SYNC_PASSWORD=false
# Add a second super admin from the console (Team & roles) before production.
# Transactional email (Brevo): see docs/EMAIL_SETUP.md
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=
# EMAIL_FROM_ADDRESS=noreply@yourdomain.com
# EMAIL_FROM_NAME=AQREM
# Dev only (explicit): EMAIL_PROVIDER=console
# Legacy alias: EMAIL_DELIVERY_MODE=log  → console in development
# CORS_ALLOWED_ORIGINS=https://your-app.example
# Production: comma-separated origins (never use * with credentials)
# CORS_ALLOWED_ORIGINS=https://app.example.com
RATE_LIMIT_ENABLED=true
API_HOST=0.0.0.0
API_PORT=8000
# One-port lab script (scripts/start-web-one-port.sh) defaults to 4173 via AQREM_WEB_PORT
# AQREM_WEB_PORT=4173
# Serve built frontend from FastAPI (the lab script sets SERVE_FRONTEND=1)
SERVE_FRONTEND=0
# Optional override; default is <repo>/frontend/dist
# FRONTEND_DIST_PATH=

# Database
DATABASE_URL=postgresql+psycopg://aqrem:aqrem@localhost:5432/aqrem

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Storage (Azurite locally)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=evidence
# Optional; Azurite is auto-detected and uses 2024-08-04. Set to override for real Azure.
# AZURE_STORAGE_BLOB_API_VERSION=
# Must be writable by the API process (use /tmp/aqrem/uploads for local dev; mount a volume for /data/uploads in Docker)
LOCAL_UPLOAD_DIR=/tmp/aqrem/uploads

# LLM — mock for local/CI; production clients use gateway (see docs/azure/CONFIG_CONTRACT.md)
LLM_PROVIDER=mock
GATEWAY_URL=
GATEWAY_API_KEY=
GATEWAY_CHAT_ALIAS=chat-default
GATEWAY_EMBEDDINGS_ALIAS=embeddings-default
GATEWAY_TIMEOUT_SECONDS=120
# Legacy lab-only direct Azure (do not use in production multi-tenant deploys)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# Production: set true when api/worker managed identity has Cognitive Services OpenAI User
AZURE_OPENAI_USE_MANAGED_IDENTITY=false
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=aqrem-embeddings
AZURE_OPENAI_CHAT_DEPLOYMENT=aqrem-chat
# Alias for chat deployment name (same as AZURE_OPENAI_CHAT_DEPLOYMENT)
# AZURE_OPENAI_DEPLOYMENT=aqrem-chat
# Mock dev: 384. Azure text-embedding-3-small: 1536 (must match pgvector — see infra/terraform/README.md)
EMBEDDING_DIMENSIONS=384

# GitHub App (optional for local dev)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Limits
MAX_UPLOAD_BYTES=52428800
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.xlsx,.csv,.txt,.md,.json,.yaml,.yml,.zip,.tar.gz
